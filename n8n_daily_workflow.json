      },
      "id": "925747e9-c05d-4208-ae11-0d0ed7febf1f",
      "name": "Run daily pipeline",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first()?.json ?? {};\nconst stdout = String(item.stdout ?? '');\nconst stderr = String(item.stderr ?? '');\nconst lines = stdout.split(/\\r?\\n/).filter(line => line.trim());\ntry {\n  if (!lines.length) throw new Error('stdout was empty');\n  return [{ json: JSON.parse(lines[lines.length - 1]) }];\n} catch (error) {\n  const tail = stderr.split(/\\r?\\n/).slice(-12).join('\\n').slice(-2000);\n  return [{ json: { ok: false, stage: 'parse', error: tail || String(error.message || error) } }];\n}"
      },
      "id": "1a853a2b-f357-4e15-a10d-507468fa36d2",
      "name": "Parse pipeline result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
