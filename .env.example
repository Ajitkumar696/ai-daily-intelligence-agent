# Groq OpenAI-compatible Chat Completions API
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Max articles per pipeline run
MAX_ARTICLES_PER_RUN=3

# X / Twitter Official API v2 (Optional: sign up at https://developer.x.com/)
TWITTER_BEARER_TOKEN=

# Product Hunt Official GraphQL API (Optional: generate token at https://www.producthunt.com/v2/oauth/applications)
PRODUCT_HUNT_DEVELOPER_TOKEN=
